# ==============================================================================
# ResearchPilot Environment Configuration
# Copy this file to .env and adjust variables as needed for local or production use.
# ==============================================================================

# Application Environment: development | production | test
# Set to 'development' for verbose logging and interactive Swagger docs at /docs.
APP_ENV=development
APP_NAME=ResearchPilot
DEBUG=true

# Application Security Key:
# Used to sign JWT access tokens. Must be a secure random string of at least 32 characters.
# Generate on Mac/Linux with: openssl rand -hex 32
APP_SECRET_KEY=change-me-to-a-secure-random-secret-key-at-least-32-chars-long

# Server Networking
PORT=8000
HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:5173

# Database & Storage
# Connection string format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
# For Docker Compose: postgresql+asyncpg://postgres:postgres@db:5432/researchpilot
# For Native Mac:     postgresql+asyncpg://postgres:postgres@localhost:5432/researchpilot
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/researchpilot

# Local storage path for uploaded research papers (relative or absolute path)
LOCAL_STORAGE_PATH=./storage/documents

# Authentication Tokens
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7

# ==============================================================================
# OpenAI & AI Model Configuration (OPTIONAL)
# ==============================================================================
# If OPENAI_API_KEY is left empty or omitted, ResearchPilot automatically runs in
# offline mode using the deterministic MockAIProvider (zero API cost, no credentials).
# If provided, ResearchPilot uses live OpenAI models for completions and embeddings.
# Get an API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Supported Chat Models: gpt-4o, gpt-4o-mini, gpt-4-turbo
OPENAI_CHAT_MODEL=gpt-4o-mini

# Supported Embedding Models: text-embedding-3-small, text-embedding-3-large
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ==============================================================================
# Document Ingestion & Chunking Limits
# ==============================================================================
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=500
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120

# ==============================================================================
# Agent Orchestrator & Safety Limits
# ==============================================================================
MAX_TOOL_CALLS_PER_RUN=25
MAX_RETRIEVED_CHUNKS_PER_RUN=40
MAX_RUN_DURATION_SECONDS=300
